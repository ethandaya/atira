{
  "name": "atira",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React and StyleX components for agent interfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethandaya/atira.git"
  },
  "bugs": {
    "url": "https://github.com/ethandaya/atira/issues"
  },
  "homepage": "https://github.com/ethandaya/atira#readme",
  "keywords": [
    "agent-interface",
    "component-library",
    "react",
    "stylex"
  ],
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm build:library && pnpm --filter @atira/demo build",
    "build:library": "node --experimental-strip-types scripts/build-library.ts",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm run doctor && pnpm build && pnpm test:browser",
    "deploy:cloudflare": "wrangler deploy",
    "dev": "pnpm --filter @atira/demo dev",
    "dev:cloudflare": "wrangler dev",
    "doctor": "react-doctor --project apps/demo,packages/primitives,packages/components,packages/blocks --no-score --no-supply-chain --blocking warning -y",
    "doctor:changed": "pnpm run doctor --scope changed --include-untracked",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "precommit": "node --experimental-strip-types node_modules/lint-staged/bin/lint-staged.js --config lint-staged.config.ts --concurrent false --hide-unstaged",
    "prepare": "husky",
    "publish:library": "node --experimental-strip-types scripts/publish-library.ts",
    "release": "pnpm publish:library",
    "start": "pnpm --filter @atira/demo start",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "pnpm --recursive --if-present typecheck && pnpm exec tsc -p apps/demo/tsconfig.backend.json && pnpm exec tsc -p cloudflare/tsconfig.json && pnpm exec tsc -p tsconfig.tools.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@babel/plugin-transform-typescript": "7.28.6",
    "@changesets/cli": "3.0.0",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "1.62.1",
    "@stylexjs/babel-plugin": "0.19.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "7.20.5",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react-doctor": "0.9.14",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.142.0",
    "ws": "8.22.0"
  }
}
