{
  "name": "pretty-amped",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @pretty-amped/demo build",
    "export:library": "node scripts/export-library.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm build && pnpm test:browser",
    "dev": "pnpm --filter @pretty-amped/demo dev",
    "test": "node --test scripts/export-library.test.mjs && vitest run",
    "test:browser": "playwright test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.0.1",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  }
}
