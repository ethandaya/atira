{
  "name": "pretty-amped",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @pretty-amped/demo build",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "dev": "pnpm --filter @pretty-amped/demo dev",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.0.1",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  }
}
