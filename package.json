{
  "name": "pretty-amped",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm build:library && pnpm --filter @pretty-amped/demo build",
    "build:library": "node scripts/build-library.mjs",
    "export:library": "node scripts/export-library.mjs",
    "pack:library": "node scripts/build-library.mjs --pack private-packages",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm run doctor && pnpm build && pnpm test:browser && pnpm test:consumers",
    "dev": "pnpm --filter @pretty-amped/demo dev",
    "doctor": "react-doctor --project apps/demo,packages/primitives,packages/components,packages/blocks --no-score --no-supply-chain --blocking error -y",
    "doctor:changed": "pnpm run doctor --scope changed --include-untracked",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "precommit": "lint-staged --concurrent false --hide-unstaged",
    "prepare": "husky",
    "test": "node --test scripts/export-library.test.mjs scripts/build-library.test.mjs && vitest run",
    "test:consumers": "node scripts/test-private-consumers.mjs",
    "test:browser": "playwright test",
    "typecheck": "pnpm --recursive --if-present typecheck && pnpm exec tsc -p apps/demo/tsconfig.backend.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@babel/plugin-transform-typescript": "7.28.6",
    "@playwright/test": "1.62.1",
    "@stylexjs/babel-plugin": "0.19.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react-doctor": "0.9.14",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "ws": "8.18.3"
  }
}
