#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

setup_started=$SECONDS

log_step() {
  printf '[setup] %s\n' "$1"
}

finish_step() {
  local label="$1"
  local started="$2"
  printf '[setup] %s finished in %ss\n' "$label" "$((SECONDS - started))"
}

log_step 'Checking the Node.js toolchain'
toolchain_started=$SECONDS

if ! command -v node >/dev/null 2>&1; then
  printf '[setup] Node.js is required but is not installed in this orb.\n' >&2
  exit 1
fi

node_version="$(node --version)"
node_semver="${node_version#v}"
node_major="${node_semver%%.*}"
node_remainder="${node_semver#*.}"
node_minor="${node_remainder%%.*}"

if [[ ! "$node_major" =~ ^[0-9]+$ ]] ||
  [[ ! "$node_minor" =~ ^[0-9]+$ ]] ||
  ((node_major < 22 || (node_major == 22 && node_minor < 13))); then
  printf '[setup] Node.js 22.13 or newer is required; found %s.\n' "$node_version" >&2
  exit 1
fi

required_pnpm="$(node -p "require('./package.json').packageManager.split('@').at(-1)")"
current_pnpm="$(pnpm --version 2>/dev/null || true)"

if [[ "$current_pnpm" != "$required_pnpm" ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    printf '[setup] npm is required to install pnpm %s.\n' "$required_pnpm" >&2
    exit 1
  fi

  log_step "Installing pnpm $required_pnpm"
  npm install --global "pnpm@$required_pnpm"
  hash -r
fi

finish_step "Node.js $node_version and pnpm $required_pnpm" "$toolchain_started"

log_step 'Installing workspace dependencies from pnpm-lock.yaml'
install_started=$SECONDS
pnpm install --frozen-lockfile --prefer-offline
finish_step 'Workspace dependency install' "$install_started"

log_step 'Installing the Playwright Chromium browser'
browser_started=$SECONDS
pnpm exec playwright install chromium
finish_step 'Playwright Chromium browser install' "$browser_started"

printf '[setup] Orb setup completed in %ss\n' "$((SECONDS - setup_started))"
