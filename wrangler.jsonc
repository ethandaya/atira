{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atira",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-27",
  "observability": {
    "enabled": true,
  },
  "containers": [
    {
      "class_name": "AtiraContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "constraints": {
        "regions": ["ENAM", "WNAM"],
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATIRA_CONTAINER",
        "class_name": "AtiraContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AtiraContainer"],
    },
  ],
}
